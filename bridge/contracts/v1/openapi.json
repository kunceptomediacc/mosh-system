{
  "openapi": "3.1.0",
  "info": {"title": "MOSH Local API", "version": "1.2.0"},
  "servers": [{"url": "http://127.0.0.1:8889"}],
  "security": [{"bearerAuth": []}, {"sessionCookie": []}],
  "paths": {
    "/api/v1/health": {"get": {"responses": {"200": {"description": "Health"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/summary": {"get": {"responses": {"200": {"description": "Repository counts"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/accounts": {"get": {"responses": {"200": {"description": "Redacted provider account health; credential references and metadata are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/agents": {"get": {"responses": {"200": {"description": "Redacted agent health and capabilities"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/projects": {"get": {"parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "Task-derived project overview with operational counts and last activity"}, "400": {"description": "Invalid pagination"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/workspace": {"get": {"responses": {"200": {"description": "Allowlisted workspace-area counts and path-free summarized Git state"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/integrations": {"get": {"responses": {"200": {"description": "Aggregate agent capabilities and fixed integration-area counts; names, paths, configuration, and credentials are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/plugins": {"get": {"responses": {"200": {"description": "Registered plugin connection metadata, health, declared capabilities, scope grants, and allowed agents; credentials are excluded and writes remain approval-gated"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/plugin-activity": {"get": {"responses": {"200": {"description": "Aggregate plugin repository allowlist and read outcome counts; repository names, paths, hashes, content, and identities are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/governance-status": {"get": {"responses": {"200": {"description": "Aggregate project governance profile, classification, requirement, change, and artifact counts; project identities, actors, evidence, and isolation keys are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/workflow-status": {"get": {"responses": {"200": {"description": "Aggregate workflow pattern, plan, and automation-tool counts; definitions, inputs, names, actors, and evidence are excluded and execution remains disabled"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/video-status": {"get": {"responses": {"200": {"description": "Aggregate Video Factory project and stage counts; briefs, evidence, actors, and artifact identities are excluded and publishing remains separately gated"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/identity-status": {"get": {"responses": {"200": {"description": "Aggregate identity provider, active-principal, and role counts; subjects, aliases, client identifiers, and credentials are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/memory-stores": {"get": {"responses": {"200": {"description": "Durable operational-memory health, schema version, domain counts, and latest timestamps; task and event content is excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/log-streams": {"get": {"responses": {"200": {"description": "Categorized durable audit-event counts, latest timestamps, and failure/cancellation/recovery totals; raw messages, payloads, output, and paths are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/system-status": {"get": {"responses": {"200": {"description": "Aggregate storage, agent, account, multi-account routing, work, and gate readiness; identities and task content are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/learning-status": {"get": {"responses": {"200": {"description": "Aggregate governed memory and skill lifecycle counts, pending approval totals, and embedding-disabled state; content, names, paths, and evidence are excluded"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/approvals": {"get": {"parameters": [{"name": "decision", "in": "query", "schema": {"type": "string", "enum": ["pending", "approved", "rejected"]}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "Approval inspection queue"}, "400": {"description": "Invalid filter or pagination"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/side-effects": {"get": {"parameters": [{"name": "status", "in": "query", "schema": {"type": "string", "enum": ["pending", "approved", "rejected", "consumed"]}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "Redacted side-effect inspection queue; targets, parameters, and digests are excluded"}, "400": {"description": "Invalid filter or pagination"}, "401": {"description": "Unauthorized"}}}},
    "/api/v1/sessions": {"get": {"responses": {"200": {"description": "Owner-only active session metadata; token digests are excluded"}, "401": {"description": "Unauthorized"}, "403": {"description": "Owner role required"}}}},
    "/api/v1/sessions/{session_id}/revoke": {"post": {"parameters": [{"name": "session_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^SES-[A-F0-9]{32}$"}}], "responses": {"200": {"description": "Another active session was revoked"}, "401": {"description": "Unauthorized"}, "403": {"description": "Owner role required"}, "404": {"description": "Active session not found"}, "409": {"description": "Current session must use logout"}}}},
    "/api/v1/principals/{principal_id}/sessions/revoke-all": {"post": {"parameters": [{"name": "principal_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "All active sessions for the principal were revoked"}, "401": {"description": "Unauthorized"}, "403": {"description": "Owner role required"}, "404": {"description": "Principal not found"}}}},
    "/api/v1/tasks": {
      "get": {"parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "Task collection"}, "400": {"description": "Invalid pagination"}, "401": {"description": "Unauthorized"}}},
      "post": {
        "security": [{"bearerAuth": [], "writeToken": []}, {"sessionCookie": [], "writeToken": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["objective", "account_id", "risk"], "properties": {"objective": {"type": "string", "minLength": 1, "maxLength": 4000}, "account_id": {"type": "string", "minLength": 1, "maxLength": 200}, "risk": {"type": "string", "enum": ["low", "medium", "high"]}}}}}},
        "responses": {"201": {"description": "Task and queued run created with pending owner approval"}, "400": {"description": "Malformed or oversized JSON"}, "401": {"description": "Invalid read token"}, "403": {"description": "Invalid write token"}, "422": {"description": "Semantic validation failure"}, "429": {"description": "Submission rate limit exceeded; Retry-After is returned"}}
      }
    },
    "/api/v1/tasks/{task_id}": {"get": {"parameters": [{"name": "task_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Task snapshot; events are available from the paginated events resource"}, "401": {"description": "Unauthorized"}, "404": {"description": "Not found"}}}},
    "/api/v1/tasks/{task_id}/events": {"get": {"parameters": [{"name": "task_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "after_event_id", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}], "responses": {"200": {"description": "Cursor-paginated task events"}, "400": {"description": "Invalid pagination"}, "401": {"description": "Unauthorized"}, "404": {"description": "Task not found"}}}},
    "/api/v1/cleanup-plans": {"get": {"responses": {"200": {"description": "Cleanup plans"}, "401": {"description": "Unauthorized"}}}}
  },
  "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}, "sessionCookie": {"type": "apiKey", "in": "cookie", "name": "mosh_session"}, "writeToken": {"type": "apiKey", "in": "header", "name": "X-MOSH-Write-Token"}}}
}
