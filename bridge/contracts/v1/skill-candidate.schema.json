{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosh.local/contracts/v1/skill-candidate.schema.json",
  "title": "MOSH Skill Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "name", "scope", "status", "risk", "procedure_ref", "procedure_sha256", "evidence_ids", "created_at"],
  "properties": {
    "skill_id": {"type": "string", "pattern": "^SKILL-[A-Z0-9-]{8,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "scope": {"type": "string", "enum": ["agent", "project", "business", "core"]},
    "scope_id": {"type": ["string", "null"], "maxLength": 200},
    "status": {"type": "string", "enum": ["candidate", "validated", "approved", "rejected", "retired"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "procedure_ref": {"type": "string", "pattern": "^skills/[A-Za-z0-9._/-]+$", "maxLength": 400},
    "procedure_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "maxLength": 200}, "uniqueItems": true},
    "test_ids": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 200}, "uniqueItems": true},
    "approval_id": {"type": ["string", "null"], "maxLength": 200},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
