{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosh.local/contracts/v1/n8n-workflow-discovery-request.schema.json",
  "title": "MOSH n8n Workflow Discovery Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version",
    "base_url",
    "operation",
    "purpose",
    "max_connector_calls",
    "max_workflows",
    "max_response_bytes",
    "persist_workflow_definitions",
    "include_credentials",
    "include_execution_records",
    "allow_mutation",
    "allow_activation",
    "allow_execution",
    "allow_webhooks"
  ],
  "properties": {
    "request_version": {"const": "1"},
    "base_url": {"const": "http://127.0.0.1:5678"},
    "operation": {"const": "workflow.list_metadata"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "max_connector_calls": {"const": 1},
    "max_workflows": {"type": "integer", "minimum": 1, "maximum": 25},
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "persist_workflow_definitions": {"const": false},
    "include_credentials": {"const": false},
    "include_execution_records": {"const": false},
    "allow_mutation": {"const": false},
    "allow_activation": {"const": false},
    "allow_execution": {"const": false},
    "allow_webhooks": {"const": false}
  }
}
